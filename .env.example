# Copie para .env.local e preencha com os seus valores.

# ID do formulário: https://formspree.io/f/SEU_ID
NEXT_PUBLIC_FORMSPREE_ID=

# Somente dígitos, com 55 e DDD. Sem esta variável, o site usa um número fictício.
NEXT_PUBLIC_WHATSAPP_NUMERO=

# Supabase: URL e chave pública do projeto (nunca a chave service_role).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Senha do banco, usada apenas pela ferramenta de linha de comando do Supabase.
SUPABASE_DB_PASSWORD=

# Usadas apenas por "npm run demo:seed". Não cadastre na Vercel.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_SENHA=
DEMO_PACIENTE_EMAIL=
# Opcional: senha para apresentar a área do cliente sem depender do envio de e-mail.
DEMO_PACIENTE_SENHA=

# Opcional: domínio final do site, usado nas meta tags.
NEXT_PUBLIC_SITE_URL=
